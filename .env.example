DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
ADMIN_TELEGRAM_IDS=YOUR_TELEGRAM_NUMERIC_ID
BOT_USERNAME=USDTMinerOfficialBot
DEPOSIT_WALLET_ADDRESS=YOUR_BEP20_WALLET_ADDRESS
BSC_RPC_URL=https://bsc-dataseed.binance.org/
USDT_BEP20_CONTRACT=0x55d398326f99059fF775485246999027B3197955
POINTS_PER_USDT=1
MIN_WITHDRAW_USDT=1000
WITHDRAW_FEE_PERCENT=10
# --- added in Part 1 ---
INITDATA_MAX_AGE_SECONDS=86400
DEPOSITS_ENABLED=false
# --- added in Part 3 ---
# Mini App short name from BotFather (/newapp). Leave empty if you use the bot's Main Mini App.
MINIAPP_SHORT_NAME=
# --- added in Part 4 ---
MIN_DEPOSIT_USDT=5
DEPOSIT_CONFIRMATIONS=15
DEPOSIT_AUTO_CREDIT=false
MAX_OPEN_WITHDRAWALS=3
USDT_DECIMALS=18
# --- Part 5 ---
# Withdrawal/deposit/reward/channel/bot options are now edited in the app (Admin > Settings).
# The env values above are only FALLBACKS used when no row exists in the settings table.
# --- Phase 2 / Part 1 (bot notifications) ---
# Any long random string. Telegram sends it back in a header so only Telegram can call the webhook.
TG_WEBHOOK_SECRET=
# Any long random string. Vercel sends it as "Authorization: Bearer <value>" to the daily cron.
CRON_SECRET=
# --- Token mode (MINER) ---
# BEP-20 contract address of your MINER token (public address only, never a private key)
MINER_TOKEN_CONTRACT=
